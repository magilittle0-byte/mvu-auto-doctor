{
  "name": "mvu-auto-doctor",
  "version": "2.0.0-rc.12",
  "description": "SillyTavern / TauriTavern 扩展：通用 MVU 审计修复、正文/装备硬合同检查、活世界事件连续性账本与内置世界论坛。",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test",
    "test:browser": "node --test tests/browser-runtime.test.mjs",
    "qc:phase6:replay": "node qc/phase6-replay-report.mjs",
    "qc:phase7:replay": "node qc/phase7-release-report.mjs",
    "qc:real:database": "node qc/july29-real-compat.mjs",
    "qc:real:model": "node qc/july29-real-model.mjs",
    "qc:real:sovereignty": "node qc/sovereignty-gemini-ab.mjs",
    "qc:real:tauri": "node qc/tauri-silent-qc.mjs",
    "qc:latest-run": "node qc/latest-run-regression.mjs",
    "release:build": "node qc/build-release.mjs",
    "qc:report": "node qc/build-rc10-report.mjs",
    "qc:fingerprint": "node qc/real-env-qc.mjs fingerprint",
    "qc:ci": "node qc/real-env-qc.mjs ci",
    "qc:install": "node qc/real-env-qc.mjs install",
    "qc:record": "node qc/real-env-qc.mjs record",
    "qc:gate": "node qc/real-env-qc.mjs verify"
  },
  "devDependencies": {
    "playwright": "1.61.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/magilittle0-byte/mvu-auto-doctor"
  },
  "license": "MIT"
}
